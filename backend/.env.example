# --- Core ---
DATABASE_URL=postgresql+psycopg://fantamazor:fantamazor@localhost:5432/fantamazor
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET_KEY=change-me-to-a-random-secret

# --- Admin login (MVP1: single admin user, seeded on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Data mode ---
# demo  = use DemoDataProvider (seeded, clearly-marked fake data, no external calls)
# manual = use ManualImportProvider only (CSV/JSON you import yourself)
# live  = also enable ApiFootballProvider when a key is present below
DATA_PROVIDER_MODE=demo

# --- API-Football (optional; leave blank to keep it reporting "unavailable") ---
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
